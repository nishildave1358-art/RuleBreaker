; Engine configuration file.
; Godot 4 project placeholder — the presentation layer (scene tree, coin, cards,
; HUD) is built in Phase 9. Phase 0 only establishes the project so the repo
; layout matches the plan. Project name follows the GDD title.
; Core library code lives outside this folder at ../src/RuleBreaker.Core and will
; be referenced via a csproj shim in Phase 9.

config_version=5

[application]

config/name="RuleBreaker: The Coin Paradox"
config/features=PackedStringArray("4.2", "C#", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
